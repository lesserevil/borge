<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+)
    This ensures cloud backup and device-to-device transfers work properly.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include SharedPreferences and app files -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
        
        <!-- Exclude cache -->
        <exclude domain="file" path="google_drive_cache"/>
    </cloud-backup>
    
    <device-transfer>
        <!-- Same rules for device-to-device transfer -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
        <exclude domain="file" path="google_drive_cache"/>
    </device-transfer>
</data-extraction-rules>
