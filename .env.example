# Android release signing configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then run:
#   make key-properties
#
# ──────────────────────────────────────────────────────────────────────
# How to get these values
# ──────────────────────────────────────────────────────────────────────
#
# 1. GENERATE A KEYSTORE (one-time)
#
#    keytool -genkey -v \
#      -keystore ~/upload-keystore.jks \
#      -storetype JKS \
#      -keyalg RSA -keysize 2048 -validity 10000 \
#      -alias upload
#
#    You'll be prompted to create a keystore password and a key password.
#    Use those values for KEYSTORE_PASSWORD and KEY_PASSWORD below.
#
# 2. REGISTER WITH GOOGLE PLAY (first release only)
#
#    a. Go to Google Play Console → your app → Setup → App signing
#    b. Choose "Upload a key exported from Android Studio"
#    c. Follow the instructions to export your key using pepk.jar:
#
#       java -jar pepk.jar \
#         --keystore=~/upload-keystore.jks \
#         --alias=upload \
#         --output=output.zip \
#         --encryptionkey=<key shown in Play Console>
#
#    d. Upload output.zip to Play Console
#
#    After this, Google holds the app signing key. Your upload key
#    (the .jks file) is used to authenticate uploads — Google re-signs
#    the APK for distribution.
#
# 3. FILL IN THE VALUES BELOW
#
# ──────────────────────────────────────────────────────────────────────

# Absolute or relative path to your .jks keystore file
KEYSTORE_FILE=~/upload-keystore.jks

# Password you set when creating the keystore
KEYSTORE_PASSWORD=

# Alias you used in the -alias flag (default: upload)
KEY_ALIAS=upload

# Password you set for the key (often same as KEYSTORE_PASSWORD)
KEY_PASSWORD=
